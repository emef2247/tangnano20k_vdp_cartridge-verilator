# Makefile: Verilator　Build (merged/run targets with DEBUG_BUILD control)
#
# Usage:
#   make                 # build and run sim (no --vramtest). --dump-screen controlled by DEBUG_BUILD
#   make sim             # same as 'make'
#   make vramtest        # build and run with --vramtest. --dump-screen controlled by DEBUG_BUILD
#   make DEBUG_BUILD=1 sim
#   make DEBUG_BUILD=1 vramtest
#
# Set DEBUG_BUILD=1 to enable runtime --dump-screen and the SDRAM debug define.

# RTL, Modification for verilator, Wrapper RTL
VPATH = /home/emef220/projects/TangCartMSX/RTL/tangnano20k_vdp_cartridge_rev2_step1/src
MOD   = ./mod
RTL   = ./RTL

# Control debug flags (override on make command-line)
DEBUG_BUILD ?= 0
SCREEN_DUMP ?= 1
VCD_DUMP    ?= 0

ifeq ($(DEBUG_BUILD),1)
  VERILATOR_FLAGS = -Wno-fatal -I$(VPATH) -DSDRAM_DEBUG -DVM_TRACE
else
  VERILATOR_FLAGS = -Wno-fatal -I$(VPATH)
endif

ifeq ($(SCREEN_DUMP),1)
  DUMP_FLAG = --dump-screen
else
  DUMP_FLAG =
endif

ifeq ($(VCD_DUMP),1)
  VCD_FLAG = --vcd dump.vcd
else
  VCD_FLAG =
endif

# RTL　file list 
VERILOG_SRCS = \
	$(RTL)/wrapper_top.sv \
	$(RTL)/ip_sdram_simple.v \
	$(MOD)/vdp_color_palette.v \
	$(MOD)/vdp_timing_control_screen_mode.v \
	$(MOD)/vdp_timing_control.v \
	$(MOD)/tangnano20k_vdp_cartridge.v \
	$(MOD)/vdp.v \
	$(VPATH)/test_top_SCREEN5_SP2/dummy.v \
	$(VPATH)/msx_slot/msx_slot.v \
	$(VPATH)/th9958/vdp_upscan_line_buffer.v \
	$(VPATH)/th9958/vdp_upscan.v \
	$(VPATH)/th9958/vdp_vram_interface.v \
	$(VPATH)/th9958/vdp_video_ram_line_buffer.v \
	$(VPATH)/th9958/vdp_video_double_buffer.v \
	$(VPATH)/th9958/vdp_video_out_bilinear.v \
	$(VPATH)/th9958/vdp_video_out.v \
	$(VPATH)/th9958/vdp_sprite_info_collect.v \
	$(VPATH)/th9958/vdp_sprite_makeup_pixel.v \
	$(VPATH)/th9958/vdp_sprite_select_visible_planes.v \
	$(VPATH)/th9958/vdp_sprite_divide_table.v \
	$(VPATH)/th9958/vdp_timing_control_ssg.v \
	$(VPATH)/th9958/vdp_timing_control_sprite.v \
	$(VPATH)/th9958/vdp_cpu_interface.v \
	$(VPATH)/th9958/vdp_color_palette_ram.v \
	$(VPATH)/th9958/vdp_command_cache.v \
	$(VPATH)/th9958/vdp_command.v \
	$(VPATH)/ws2812_led/ip_ws2812_led.v \
	$(VPATH)/debugger/ip_debugger.v 

# C++ Source
C_SRCS = vdp_cartridge_wrapper.cpp main.cpp

# ----------------
all: sim

# Binary name generated by Verilator（top-module = wrapper_top）
SIM_BIN = obj_dir/Vwrapper_top

sim: $(SIM_BIN)
	./$(SIM_BIN) $(DUMP_FLAG) $(VCD_FLAG)

vramtest: $(SIM_BIN)
	./$(SIM_BIN) --vramtest $(DUMP_FLAG) $(VCD_FLAG)

screen1sp: $(SIM_BIN)
	./$(SIM_BIN) --csv tests/csv/test_vdp_SCREEN1_SP.csv $(DUMP_FLAG) $(VCD_FLAG)

screen7vram: $(SIM_BIN)
	./$(SIM_BIN) --csv tests/csv/test_vdp_SCREEN7_VRAM.csv $(DUMP_FLAG) $(VCD_FLAG)

deskpack: $(SIM_BIN)
	./$(SIM_BIN) --csv tests/csv/fsa1_deskpack.csv $(DUMP_FLAG) $(VCD_FLAG)

msx2logo: $(SIM_BIN)
	./$(SIM_BIN) --csv tests/csv/msx2_logo.csv $(DUMP_FLAG) $(VCD_FLAG)

$(SIM_BIN): $(VERILOG_SRCS) $(C_SRCS)
	verilator --cc --exe --build --trace $(VERILATOR_FLAGS) \
		$(VERILOG_SRCS) $(C_SRCS) --top-module wrapper_top

clean:
	rm -rf obj_dir Vwrapper_top* Vtangnano20k_vdp_cartridge* *.o *.d

.PHONY: all sim vramtest screen1sp screen7vram deskpack msx2logo clean